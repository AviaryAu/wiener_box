{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "wiener-box",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "test:browser": "playwright test",
    "format": "prettier --write \"resources/**/*.{ts,vue,css}\" \"tests/Browser/**/*.ts\" playwright.config.ts vite.config.js",
    "format:check": "prettier --check \"resources/**/*.{ts,vue,css}\" \"tests/Browser/**/*.ts\" playwright.config.ts vite.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.3",
    "laravel-vite-plugin": "^3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vue-tsc": "^3.3.11"
  },
  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@inertiajs/vue3": "^2.3.28",
    "@lucide/vue": "^1.46.0",
    "axios": "^1.20.0",
    "vue": "^3.5.42"
  }
}
